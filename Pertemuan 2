2.13.1 Versi dengan Jejak Eksekusi
Contoh 2.19 Binary Search dengan trace
def binary_search_trace(data, target):
  left = 0
  right = len(data) - 1

  while left <= right:
    mid = (left + right) // 2
    print('left=', left, 'right=', right, 'mid=', mid, 'nilai=', data[mid])

    if data[mid] == target:
      return mid
    elif data[mid] < target:
      left = mid + 1
    else:
      right = mid - 1

  return -1
  
binary_search_trace([12,18,25,31,44,57,63,70,82], 57)

2.16.1 Menyiapkan Fungsi Contoh 2.20 Eksperimen sederhana menggunakan timeit
for n in [1_000, 10_000, 100_000]:
  data = list(range(n))
  target = -1

  t_linear = timeit.timeit(
    lambda: linear_search(data, target),
    number=100
  )
  t_binary = timeit.timeit(
    lambda: binary_search(data, target),
    number=100
  )
  
  print('n =', n)
  print(' linear:', t_linear)
  print(' binary:', t_binary)

  
