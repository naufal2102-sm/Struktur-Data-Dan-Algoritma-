2.9.3 Mencari Semua Kemunculan Contoh 2.15 Mencari seluruh kemunculan target
def linear_search_all(data, target):
  posisi = []
  for index, value in enumerate(data):
    if value == target:
      posisi.append(index)
  return posisi
  
