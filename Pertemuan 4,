4.13. Implementasi Stack Menggunakan Linked List
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class LinkedStack:
    def __init__(self):
        self.top = None
        self.count = 0

    def is_empty(self):
        return self.top is None

    def push(self, data):
        new_node = Node(data)
        new_node.next = self.top
        self.top = new_node
        self.count += 1

    def pop(self):
        if self.is_empty():
            return None

        data = self.top.data
        self.top = self.top.next
        self.count -= 1
        return data

    def peek(self):
        if self.is_empty():
            return None
        return self.top.data

    def size(self):
        return self.count


linked_stack = LinkedStack()

linked_stack.push("A")
linked_stack.push("B")
linked_stack.push("C")

print("Top:", linked_stack.peek())
print("Ukuran:", linked_stack.size())
print("Pop:", linked_stack.pop())
print("Top setelah pop:", linked_stack.peek())

