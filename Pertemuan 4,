4.10. Apakah Stack Bisa Overflow?
class BoundedStack:
    def __init__(self, capacity):
        self.items = []
        self.capacity = capacity

    def push(self, data):
        if len(self.items) >= self.capacity:
            return False

        self.items.append(data)
        return True


s = BoundedStack(2)

print(s.push("A"))
print(s.push("B"))
print(s.push("C"))

