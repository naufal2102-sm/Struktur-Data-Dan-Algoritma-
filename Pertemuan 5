Membuat fungsi is_palindrome() 
from collections import deque

def is_palindrome(text, tampilkan_pasangan=False):
    # Normalisasi: huruf kecil dan hanya huruf/angka
    chars = deque(
        c.lower() for c in text if c.isalnum()
    )

    while len(chars) > 1:
        kiri = chars.popleft()
        kanan = chars.pop()

        if tampilkan_pasangan:
            print(f"Kiri: {kiri} | Kanan: {kanan}")

        if kiri != kanan:
            if tampilkan_pasangan:
                print("Hasil: Bukan palindrome")
            return False

    if tampilkan_pasangan:
        print("Hasil: Palindrome")

    return True


